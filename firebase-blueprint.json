{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat session belonging to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message in a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "userId": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "assistant"] },
        "text": { "type": "string" },
        "verdict": { "type": "string" },
        "isProhibited": { "type": "boolean" },
        "sources": { "type": "array" },
        "scriptureRef": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "chatId", "userId", "sender", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user account profile"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat conversation sessions for a user"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages inside a chat conversation"
    }
  }
}
